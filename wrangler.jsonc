{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alifa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "854abc0a-9ef6-43a4-943f-b334b1cfdbd2","database_name": "alidb" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "88c0860a494a477fb480ef598236c16a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
